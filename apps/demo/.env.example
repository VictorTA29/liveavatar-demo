# Copia este archivo a .env.local y rellena los valores.
# En Netlify, define estas mismas variables en
# Site configuration > Environment variables.

# --- Obligatorio ---
# Tu API key de LiveAvatar: https://app.liveavatar.com
LIVEAVATAR_API_KEY=

# --- Opcional ---
# Solo para el panel "Probar sin gastar sesion" del modulo de conocimientos
OPENAI_API_KEY=
# Solo para la pagina /elevenlabs-agent
ELEVENLABS_API_KEY=

# --- Opcionales: sobrescriben los valores por defecto del demo ---
# "false" desactiva sandbox (las sesiones consumen creditos)
LIVEAVATAR_IS_SANDBOX=true
LIVEAVATAR_AVATAR_ID=
LIVEAVATAR_CONTEXT_ID=
LIVEAVATAR_VOICE_ID=
LIVEAVATAR_LANGUAGE=es
LIVEAVATAR_API_URL=https://api.liveavatar.com
